{
  "expo": {
    "scheme": "startHub-app",
    "name": "startHub-app",
    "slug": "startHub-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jininsa.startHubapp",
      "config": { "usesPushNotifications": true },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/icon.png",
        "backgroundColor": "#ffffff" 
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jininsa.startHubapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b64a97ca-fb5f-4166-8b92-d7ac35534cad"
      }
    },
    "owner": "iszero",
    "plugins": [
      "expo-web-browser",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/notification.wav"],
          "mode": "production"
        }
      ]
    ]
  }
}
